<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AC8 · CreeperUX 玩家工具（本地预览）" Width="1040" Height="780" MinWidth="880" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{DynamicResource CxBg}" Foreground="{DynamicResource CxText}" FontFamily="{DynamicResource CxSans}" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="12,5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource CxText}"/><Setter Property="BorderBrush" Value="{DynamicResource CxBoundary}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CxHover}"/></Trigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="primary"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CxAccentHi}"/></MultiTrigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource CxFocus}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Tag" Value="primary"><Setter Property="Background" Value="{DynamicResource CxAccent}"/><Setter Property="Foreground" Value="{DynamicResource CxOnAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource CxAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="10,4"/><Setter Property="Background" Value="{DynamicResource CxDeep}"/><Setter Property="Foreground" Value="{DynamicResource CxText}"/><Setter Property="CaretBrush" Value="{DynamicResource CxText}"/><Setter Property="BorderBrush" Value="{DynamicResource CxBoundary}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="{DynamicResource CxAccentSoft}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource CxFocus}"/><Setter TargetName="Edge" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton">
   <Setter Property="Padding" Value="12"/><Setter Property="Foreground" Value="{DynamicResource CxText}"/><Setter Property="Background" Value="{DynamicResource CxDeep}"/><Setter Property="BorderBrush" Value="{DynamicResource CxBoundary}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Choice" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource CxHover}"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource CxAccentSoft}"/><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource CxAccentMark}"/><Setter Property="Foreground" Value="{DynamicResource CxAccentText}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource CxFocus}"/><Setter TargetName="Choice" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Choice" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource CxText}"/><Setter Property="Background" Value="{DynamicResource CxDeep}"/><Setter Property="BorderBrush" Value="{DynamicResource CxBoundary}"/><Setter Property="MinHeight" Value="28"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource CxAccentSoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource CxDeep}" BorderBrush="{DynamicResource CxBoundary}" BorderThickness="1" CornerRadius="5"><TextBlock Text="▾" HorizontalAlignment="Right" Margin="0,4,8,4" Foreground="{DynamicResource CxMuted}"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <TextBlock x:Name="ChoiceHint" Text="检测到多个位置，请选择…" Visibility="Collapsed" IsHitTestVisible="False" Foreground="{DynamicResource CxMuted}" Margin="8,5,24,5"/><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,5,24,5"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="{DynamicResource CxRaised}" BorderBrush="{DynamicResource CxBoundary}" BorderThickness="1" CornerRadius="5" MinWidth="300"><ScrollViewer MaxHeight="180"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="SelectedIndex" Value="-1"><Setter TargetName="ChoiceHint" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource CxRaised}"/><Setter Property="Foreground" Value="{DynamicResource CxText}"/><Setter Property="BorderBrush" Value="{DynamicResource CxBoundary}"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CxPanel}"/><Setter Property="BorderBrush" Value="{DynamicResource CxLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource CxMuted}"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
 </Window.Resources>
 <Grid x:Name="PreviewRoot" Margin="24" Background="{DynamicResource CxBg}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource CxLine}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,0,20">
   <Grid><StackPanel>
    <StackPanel Orientation="Horizontal"><Border Width="3" Background="{DynamicResource CxAccentMark}" Margin="0,0,10,0"/><TextBlock Text="CREEPERUX / AC8" FontFamily="{DynamicResource CxDisplay}" FontSize="17" Foreground="{DynamicResource CxText}"/></StackPanel>
    <TextBlock Text="游戏安装与维护" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,6"/>
    <TextBlock Text="选择安装内容，连接 Steam，管理加载器。" Foreground="{DynamicResource CxMuted}"/>
   </StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Border Background="{DynamicResource CxRaised}" BorderBrush="{DynamicResource CxLine}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,8,0"><TextBlock x:Name="PackageVersion" Text="发布候选" FontSize="12" Foreground="{DynamicResource CxMuted}"/></Border><Button x:Name="ThemeToggle" Content="切换浅色" AutomationProperties.Name="切换深色或浅色主题"/></StackPanel></Grid>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Panel}" Margin="0,0,16,0" VerticalAlignment="Top"><StackPanel>
     <TextBlock Text="01 / INSTALLATION" FontFamily="{DynamicResource CxMono}" FontSize="12" Foreground="{DynamicResource CxQuiet}"/><TextBlock Text="游戏与安装内容" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,20"/>
     <TextBlock Text="游戏位置" Style="{StaticResource Caption}"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GamePath" AutomationProperties.Name="游戏路径"/><Button x:Name="BrowseGame" Grid.Column="1" Content="浏览…" Margin="8,0,0,0"/></Grid>
     <ComboBox x:Name="GameCandidates" Visibility="Collapsed" Margin="0,6,0,0" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="检测到多个游戏位置，请选择" ToolTip="检测到多个游戏位置，请展开选择；也可直接修改上方路径。"/>
     <TextBlock Text="可选择根目录、Win64，或粘贴 EXE 路径。" FontSize="11" Foreground="{DynamicResource CxQuiet}" Margin="0,6,0,16"/>
     <TextBlock Text="Steam 程序" Style="{StaticResource Caption}"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SteamPath" AutomationProperties.Name="Steam 程序路径"/><Button x:Name="BrowseSteam" Grid.Column="1" Content="浏览…" Margin="8,0,0,0"/></Grid>
     <ComboBox x:Name="SteamCandidates" Visibility="Collapsed" Margin="0,6,0,0" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="检测到多个 Steam 位置，请选择" ToolTip="检测到多个 Steam 位置，请展开选择。"/>
     <TextBlock Text="安装范围 · 三种均包含鼠标飞控" Style="{StaticResource Caption}" Margin="0,20,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <RadioButton x:Name="GuidanceOnly" GroupName="Features" Margin="0,0,8,0" Padding="10" AutomationProperties.Name="飞控加仅比例引导"><StackPanel><TextBlock Text="仅比例引导" FontWeight="SemiBold"/><TextBlock Text="原版性能与外观" FontSize="11" Margin="0,4,0,0"/></StackPanel></RadioButton>
      <RadioButton x:Name="FullInstall" Grid.Column="1" GroupName="Features" Margin="0,0,8,0" Padding="10" IsChecked="True" AutomationProperties.Name="飞控加完整导弹强化"><StackPanel><TextBlock Text="完整导弹强化" FontWeight="SemiBold"/><TextBlock Text="启用全部强化" FontSize="11" Margin="0,4,0,0"/></StackPanel></RadioButton>
      <RadioButton x:Name="MouseOnly" Grid.Column="2" GroupName="Features" Padding="10" AutomationProperties.Name="仅鼠标飞控"><StackPanel><TextBlock Text="仅鼠标飞控" FontWeight="SemiBold"/><TextBlock Text="原版导弹" FontSize="11" Margin="0,4,0,0"/></StackPanel></RadioButton>
     </Grid>
     <TextBlock x:Name="ModeDescription" Text="启用比例引导、性能强化、近炸设置与外观替换。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource CxMuted}" Margin="0,8,0,0"/>
     <WrapPanel Margin="0,20,0,0"><Button x:Name="Detect" Content="自动定位" Margin="0,0,8,0"/><Button x:Name="Check" Content="检查环境" Margin="0,0,8,0"/><Button x:Name="Save" Content="保存设置" Tag="primary"/></WrapPanel>
    </StackPanel></Border>
    <StackPanel Grid.Column="1">
     <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="02 / STEAM" FontFamily="{DynamicResource CxMono}" FontSize="12" Foreground="{DynamicResource CxQuiet}"/><TextBlock Text="连接并启动" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,14"/>
      <TextBlock Text="保存后复制启动选项，粘贴到 Steam → AC8 → 属性 → 通用。" TextWrapping="Wrap" Foreground="{DynamicResource CxMuted}" LineHeight="20" Margin="0,0,0,12"/>
      <TextBox x:Name="LaunchOption" IsReadOnly="True" Text="保存设置后显示启动选项" AutomationProperties.Name="Steam 启动选项" FontSize="12" FontFamily="{DynamicResource CxMono}" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,16,0,0"><Button x:Name="CopyOption" Content="复制启动选项" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="Start" Content="从 Steam 启动" Tag="primary"/></WrapPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="16"><StackPanel><TextBlock Text="游戏内功能 · 三种安装范围均包含" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="F2  头盔瞄准：每次启动默认关闭；开启后圆环增加四向刻度。" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource CxMuted}" LineHeight="18"/><TextBlock Text="F3  原生 / 拉远机位　·　C  自由观察" FontSize="12" Foreground="{DynamicResource CxMuted}" Margin="0,5,0,0"/><TextBlock Text="头盔瞄准辅助选目标，武器仍需正常锁定。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource CxQuiet}" Margin="0,6,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Panel}" Margin="0,16,0,0"><StackPanel><TextBlock Text="维护与恢复" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="遇到历史残留时，确认归属后先备份再清理。" Foreground="{DynamicResource CxMuted}" TextWrapping="Wrap" LineHeight="20"/><WrapPanel Margin="0,14,0,0"><Button x:Name="Recover" Content="备份并清理" Margin="0,0,8,0"/><Button x:Name="OpenLogs" Content="诊断文件夹"/></WrapPanel></StackPanel></Border>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <Border x:Name="StatusCard" Grid.Row="2" Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="StatusMark" Background="{DynamicResource CxInfo}"/><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock x:Name="StatusTitle" Text="先选择游戏位置" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock x:Name="StatusMessage" Text="检查与清理结果会显示在这里。普通游玩不需要 Python 或 NumPy。" Foreground="{DynamicResource CxMuted}" TextWrapping="Wrap" LineHeight="20"/><ProgressBar x:Name="BusyBar" Height="2" Background="{DynamicResource CxFaint}" Foreground="{DynamicResource CxAccent}" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/></StackPanel></Grid></Border>
  <Grid Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="游戏运行时保留启动控制台，退出后等待自动清理。" FontSize="11" Foreground="{DynamicResource CxQuiet}"/><TextBlock Text="CREEPERUX" HorizontalAlignment="Right" FontFamily="{DynamicResource CxMono}" FontSize="11" Foreground="{DynamicResource CxQuiet}"/></Grid>
 </Grid>
</Window>
