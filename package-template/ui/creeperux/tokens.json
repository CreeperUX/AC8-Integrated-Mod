{
  "$description": "CreeperUX design tokens: the single source for kit/foundation.css, kit/tokens.js and kit/tokens.json (DTCG export). Edit this file, then run `npm run build:kit`. Decisions: D10–D18, D27 (quiet motion), D30 (neutral defaults).",
  "color": {
    "bg":          { "dark": "#0d1114", "light": "#efebe5" },
    "deep":        { "dark": "#090d10", "light": "#e6e1d8" },
    "panel":       { "dark": "#151b1f", "light": "#f8f6f1" },
    "raised":      { "dark": "#1b2227", "light": "#ffffff" },
    "hover":       { "dark": "#20272b", "light": "#ffffff" },
    "text":        { "dark": "#f4f1eb", "light": "#111416" },
    "muted":       { "dark": "#a9b0b3", "light": "#5c6265" },
    "quiet":       { "dark": "#839196", "light": "#5f6466" },
    "line":        { "dark": "rgba(239, 235, 229, .14)", "light": "rgba(5, 6, 7, .15)" },
    "faint":       { "dark": "rgba(239, 235, 229, .07)", "light": "rgba(5, 6, 7, .07)" },
    "control":     { "dark": "#373737", "light": "#d9d1c4" },
    "boundary":    { "dark": "#6b767c", "light": "#827d75", "note": "Control edges: 3:1 or more on every surface (WCAG 1.4.11, D65). --cx-line stays for decorative separators." },
    "accent":      { "dark": "#f8b700", "light": "#f8b700", "note": "Brand accent; override for another brand. Fills and large marks." },
    "accent-hi":   { "dark": "#ffc522", "light": "#ffc522" },
    "accent-text": { "dark": "#f8b700", "light": "#6c4c00", "note": "Accent used as text: dark gold in light mode (D16)." },
    "accent-mark": { "dark": "#f8b700", "light": "#8a6200", "note": "Small marks and indicators (selection edge, active tab)." },
    "on-accent":   { "dark": "#111416", "light": "#111416" },
    "accent-soft": { "dark": "rgba(248, 183, 0, .12)", "light": "rgba(248, 183, 0, .22)" },
    "focus":       { "dark": "#f8b700", "light": "#8a6200" },
    "info":        { "dark": "#6497a7", "light": "#406878" },
    "good":        { "dark": "#80ab9e", "light": "#326d5d" },
    "bad":         { "dark": "#c1877c", "light": "#944e46" },
    "warn":        { "dark": "#d9a441", "light": "#805b00" },
    "scrim":       { "dark": "rgba(3, 5, 6, .55)", "light": "rgba(40, 36, 30, .28)" },
    "shadow":      { "dark": "0 16px 48px rgba(0, 0, 0, .45)", "light": "0 14px 40px rgba(40, 32, 20, .18)", "type": "shadow" }
  },
  "printColors": { "$description": "Print (G46): the light colours, with every surface white", "bg": "#ffffff", "deep": "#ffffff", "panel": "#ffffff", "raised": "#ffffff", "hover": "#ffffff" },
  "forcedColors": {
    "bg": "Canvas", "deep": "Canvas", "panel": "Canvas", "raised": "Canvas", "hover": "Canvas",
    "text": "CanvasText", "muted": "CanvasText", "quiet": "GrayText", "line": "CanvasText", "faint": "GrayText", "control": "ButtonFace", "boundary": "CanvasText",
    "accent": "Highlight", "accent-hi": "Highlight", "accent-text": "LinkText", "accent-mark": "Highlight", "on-accent": "HighlightText", "accent-soft": "Canvas",
    "focus": "Highlight", "info": "CanvasText", "good": "CanvasText", "bad": "CanvasText", "warn": "CanvasText", "scrim": "transparent", "shadow": "none"
  },
  "font": {
    "cjk": "\"PingFang SC\", \"Hiragino Sans\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", \"Source Han Sans SC\"",
    "sans": "\"Segoe UI Variable Text\", \"Segoe UI\", -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", var(--cx-font-cjk), sans-serif",
    "mono": "\"Share Tech Mono\", \"Cascadia Mono\", ui-monospace, Consolas, var(--cx-font-cjk), monospace",
    "display": "\"Chakra Petch\", var(--cx-font-sans)",
    "figure": "var(--cx-font-mono)"
  },
  "type": { "xs": "11px", "sm": "12px", "md": "13px", "lg": "14px", "xl": "17px", "2xl": "22px", "lineHeight": "1.45", "labelTracking": ".08em" },
  "density": {
    "compact": { "fs": "13px", "fs-sm": "12px", "fs-xs": "11px", "ctl": "28px", "row": "34px", "hit": "28px", "gap": "8px", "pad": "12px", "gutter": "16px", "icon": "16px" },
    "touch":   { "fs": "14px", "fs-sm": "12.5px", "fs-xs": "11.5px", "ctl": "36px", "row": "44px", "hit": "44px", "gap": "8px", "pad": "12px", "gutter": "16px", "icon": "18px" }
  },
  "radius": { "panel": "6px", "control": "5px", "chip": "4px" },
  "layer": { "content": 0, "sticky": 2, "savebar": 5, "scrim": 40, "drawer": 41, "menu": 60, "palette": 70, "dialog": 80, "toast": 90, "tooltip": 95 },
  "breakpoint": { "rail": 760, "stack": 1000, "sidebar": 1100 },
  "motion": {
    "$description": "Quiet profile (D27). t = tween {d seconds, e cubic-bezier}; s = spring {r response seconds, z damping ratio}; instant = no motion.",
    "roles": {
      "press":    { "t": "tween",  "d": 0.06, "e": [0.2, 0.8, 0.2, 1], "use": "pointer down (scale 0.985)" },
      "release":  { "t": "tween",  "d": 0.12, "e": [0.2, 0.8, 0.2, 1], "use": "pointer up" },
      "control":  { "t": "spring", "r": 0.2,  "z": 1,    "use": "small indicators: segmented, nav, selection, active option" },
      "detent":   { "t": "spring", "r": 0.24, "z": 0.82, "use": "switch knob, slider snap (only tactile role)" },
      "drag":     { "t": "spring", "r": 0.32, "z": 0.9,  "use": "release of a dragged sheet or handle" },
      "enter":    { "t": "tween",  "d": 0.14, "e": [0.2, 0.8, 0.2, 1], "use": "overlay / item entrance: opacity + at most 4 px" },
      "exit":     { "t": "tween",  "d": 0.09, "e": [0.4, 0, 0.9, 0.55], "use": "overlay / item exit" },
      "layout":   { "t": "tween",  "d": 0.18, "e": [0.2, 0.8, 0.2, 1], "use": "height of inserted / removed items" },
      "list":     { "t": "instant", "use": "reorder and filter move instantly; new items fade with enter" },
      "view":     { "t": "tween",  "d": 0.15, "e": [0.2, 0.8, 0.2, 1], "use": "view and content swap: opacity only" },
      "viewExit": { "t": "instant", "use": "outgoing view leaves at once" },
      "push":     { "t": "tween",  "d": 0.22, "e": [0.2, 0.8, 0.2, 1], "use": "phone push navigation (spatial)" },
      "sheet":    { "t": "spring", "r": 0.32, "z": 1,    "use": "drawer / sheet open and programmatic close" },
      "expand":   { "t": "tween",  "d": 0.18, "e": [0.2, 0.8, 0.2, 1], "use": "disclosure height" }
    },
    "reduced": { "opacity": { "t": "tween", "d": 0.1, "e": [0.2, 0, 0.2, 1] }, "other": { "t": "instant" } },
    "press": 0.985
  }
}
